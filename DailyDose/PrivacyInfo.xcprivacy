<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Nothing leaves the device: no account, no server, no analytics, and no
	     network code anywhere in the target. Medication and adherence data is
	     stored locally in SwiftData and only leaves via a backup file the user
	     exports themselves through the share sheet. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1 — read/write only this app's own preferences
				     (reminder settings, dose window). Never shared. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
